{
  "json.schemas": [
    {
      "fileMatch": ["**/recipes.json"],
      "url": "./docs/specification/data/recipes.schema.json"
    },
    {
      "fileMatch": ["**/config.json", "**/config.example.json"],
      "url": "./docs/specification/data/config.schema.json"
    }
  ],
  "markdownlint.config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
