{
  "name": "BrewberryPi",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    // `make image` builds with the host's Docker engine.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Claude Code CLI (the VS Code extension is listed below).
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "remoteUser": "vscode",
  "mounts": [
    // Keeps the Claude Code login and settings across container rebuilds.
    "source=brewberrypi-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": { "label": "BrewberryPi" },
    "5173": { "label": "Vite dev server" }
  },
  "postCreateCommand": "make setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "vitest.explorer",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "davidanson.vscode-markdownlint",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
